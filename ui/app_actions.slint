    callback play_track_by_id(string);
    callback play_all_from_list(string);
    callback toggle_track_like(string);
    callback clear_queue();
    callback remove_queue_track(int);
    callback cycle_quality();
    callback select_quality(string);
    callback open_comments();
    callback close_comments();
    callback play_random();
    callback collect_playlist(string);
}

